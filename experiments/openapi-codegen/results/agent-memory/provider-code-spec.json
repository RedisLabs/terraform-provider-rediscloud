											{
												"custom": {
													"imports": [
														{
															"path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
														}
													],
													"schema_definition": "int64validator.Between(60, 600)"
												}
											}
										]
									}
								}
							],
							"description": "Cadence configuration for the extraction pipeline."
						}
					},
					{
						"name": "extraction_strategy",
						"string": {
							"computed_optional_required": "computed_optional",
							"description": "Extraction strategy for promoting short-term memory to long-term memory. Defaults\nto `INSTRUCT`.",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.OneOf(\n\"INSTRUCT\",\n)"
									}
								}
							]
						}
					},
					{
						"name": "long_term_memory",
						"single_nested": {
							"computed_optional_required": "computed_optional",
							"attributes": [
								{
									"name": "classification",
									"single_nested": {
										"computed_optional_required": "computed_optional",
										"attributes": [
											{
												"name": "credentials",
												"single_nested": {
													"computed_optional_required": "computed_optional",
													"attributes": [
														{
															"name": "api_key",
															"string": {
																"computed_optional_required": "computed_optional",
																"description": "The provider API key. Required on create. On update, omit it to keep the\ncurrent key.",
																"sensitive": true
															}
														},
														{
															"name": "type",
															"string": {
																"computed_optional_required": "required",
																"description": "How the secret behind a model credential is to be interpreted.",
																"validators": [
																	{
																		"custom": {
																			"imports": [
																				{
																					"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																				}
																			],
																			"schema_definition": "stringvalidator.OneOf(\n\"API_KEY\",\n)"
																		}
																	}
																]
															}
														}
													],
													"description": "A provider credential. Never returned by any operation."
												}
											},
											{
												"name": "model",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "The model to use. Required on create. On update, omit it to keep the current\nmodel."
												}
											},
											{
												"name": "provider",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "The model provider."
												}
											}
										],
										"description": "A model selection."
									}
								},
								{
									"name": "embedding",
									"single_nested": {
										"computed_optional_required": "computed_optional",
										"attributes": [
											{
												"name": "credentials",
												"single_nested": {
													"computed_optional_required": "computed_optional",
													"attributes": [
														{
															"name": "api_key",
															"string": {
																"computed_optional_required": "computed_optional",
																"description": "The provider API key. Required on create. On update, omit it to keep the\ncurrent key.",
																"sensitive": true
															}
														},
														{
															"name": "type",
															"string": {
																"computed_optional_required": "required",
																"description": "How the secret behind a model credential is to be interpreted.",
																"validators": [
																	{
																		"custom": {
																			"imports": [
																				{
																					"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																				}
																			],
																			"schema_definition": "stringvalidator.OneOf(\n\"API_KEY\",\n)"
																		}
																	}
																]
															}
														}
													],
													"description": "A provider credential. Never returned by any operation."
												}
											},
											{
												"name": "model",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "The model to use. Required on create. On update, omit it to keep the current\nmodel."
												}
											},
											{
												"name": "provider",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "The model provider."
												}
											}
										],
										"description": "A model selection."
									}
								},
								{
									"name": "llm",
									"single_nested": {
										"computed_optional_required": "computed_optional",
										"attributes": [
											{
												"name": "credentials",
												"single_nested": {
													"computed_optional_required": "computed_optional",
													"attributes": [
														{
															"name": "api_key",
															"string": {
																"computed_optional_required": "computed_optional",
																"description": "The provider API key. Required on create. On update, omit it to keep the\ncurrent key.",
																"sensitive": true
															}
														},
														{
															"name": "type",
															"string": {
																"computed_optional_required": "required",
																"description": "How the secret behind a model credential is to be interpreted.",
																"validators": [
																	{
																		"custom": {
																			"imports": [
																				{
																					"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																				}
																			],
																			"schema_definition": "stringvalidator.OneOf(\n\"API_KEY\",\n)"
																		}
																	}
																]
															}
														}
													],
													"description": "A provider credential. Never returned by any operation."
												}
											},
											{
												"name": "model",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "The model to use. Required on create. On update, omit it to keep the current\nmodel."
												}
											},
											{
												"name": "provider",
												"string": {
													"computed_optional_required": "computed_optional",
													"description": "The model provider."
												}
											}
										],
										"description": "A model selection."
									}
								},
								{
									"name": "session_summary_enabled",
									"bool": {
										"computed_optional_required": "computed_optional",
										"default": {
											"static": false
										},
										"description": "Extract session summaries into long-term memory. Takes effect only when the\ndeployment enables session summary extraction."
									}
								},
								{
									"name": "ttl_seconds",
									"int64": {
										"computed_optional_required": "computed_optional",
										"default": {
											"static": 31536000
										},
										"description": "Time-to-live in seconds for long-term memory entries. Defaults to 1 year.",
										"validators": [
											{
												"custom": {
													"imports": [
														{
															"path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
														}
													],
													"schema_definition": "int64validator.Between(1, 31536000)"
												}
											}
										]
									}
								}
							],
							"description": "Long-term memory configuration.\n\nOn Redis Cloud, `llm` and `embedding` select the store's own models and must be\nsupplied together; `classification` is independent. Omit them to use the platform\nmodels. The embedding model cannot be changed after the store is created."
						}
					},
					{
						"name": "long_term_memory_exclusions",
						"single_nested": {
							"computed_optional_required": "computed_optional",
							"attributes": [
								{
									"name": "built_in_detectors",
									"single_nested": {
										"computed_optional_required": "computed_optional",
										"attributes": [
											{
												"name": "detectors",
												"list_nested": {
													"computed_optional_required": "computed_optional",
													"nested_object": {
														"attributes": [
															{
																"name": "action",
																"string": {
																	"computed_optional_required": "computed_optional",
																	"description": "What to do with a memory a detector matched. Defaults to `redact`. When matching\ndetectors disagree, `drop` wins.",
																	"validators": [
																		{
																			"custom": {
																				"imports": [
																					{
																						"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																					}
																				],
																				"schema_definition": "stringvalidator.OneOf(\n\"REDACT\",\n\"DROP\",\n)"
																			}
																		}
																	]
																}
															},
															{
																"name": "enabled",
																"bool": {
																	"computed_optional_required": "required",
																	"description": "Whether this detector is active."
																}
															},
															{
																"name": "id",
																"string": {
																	"computed_optional_required": "required",
																	"description": "The built-in detector id, as listed by ListBuiltInDetectors."
																}
															}
														]
													},
													"description": "The selected detectors."
												}
											},
											{
												"name": "enabled",
												"bool": {
													"computed_optional_required": "required",
													"description": "Toggle for the whole built-in group. False keeps the selections stored but\ninactive."
												}
											}
										],
										"description": "Selection of platform built-in detectors for a store. Nothing is selected by\ndefault."
									}
								},
								{
									"name": "custom_detectors",
									"single_nested": {
										"computed_optional_required": "computed_optional",
										"attributes": [
											{
												"name": "detectors",
												"list_nested": {
													"computed_optional_required": "computed_optional",
													"nested_object": {
														"attributes": [
															{
																"name": "action",
																"string": {
																	"computed_optional_required": "computed_optional",
																	"description": "What to do with a memory a detector matched. Defaults to `redact`. When matching\ndetectors disagree, `drop` wins.",
																	"validators": [
																		{
																			"custom": {
																				"imports": [
																					{
																						"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																					}
																				],
																				"schema_definition": "stringvalidator.OneOf(\n\"REDACT\",\n\"DROP\",\n)"
																			}
																		}
																	]
																}
															},
															{
																"name": "enabled",
																"bool": {
																	"computed_optional_required": "required",
																	"description": "Whether this detector is active."
																}
															},
															{
																"name": "matcher",
																"single_nested": {
																	"computed_optional_required": "required",
																	"attributes": [
																		{
																			"name": "kind",
																			"string": {
																				"computed_optional_required": "required",
																				"description": "The supported matching techniques.",
																				"validators": [
																					{
																						"custom": {
																							"imports": [
																								{
																									"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																								}
																							],
																							"schema_definition": "stringvalidator.OneOf(\n\"REGEX\",\n)"
																						}
																					}
																				]
																			}
																		},
																		{
																			"name": "regex",
																			"single_nested": {
																				"computed_optional_required": "computed_optional",
																				"attributes": [
																					{
																						"name": "pattern",
																						"string": {
																							"computed_optional_required": "required",
																							"description": "The pattern, in RE2 syntax.",
																							"validators": [
																								{
																									"custom": {
																										"imports": [
																											{
																												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																											}
																										],
																										"schema_definition": "stringvalidator.LengthBetween(1, 512)"
																									}
																								}
																							]
																						}
																					}
																				],
																				"description": "A regular expression in RE2 syntax (no lookaround or backreferences). Required\nwhen `kind` is `regex`, and rejected otherwise. Rejected if it does not compile, or\nif it can match empty text."
																			}
																		}
																	],
																	"description": "How a detector matches. Exactly the block named by `kind` must be present."
																}
															},
															{
																"name": "name",
																"string": {
																	"computed_optional_required": "required",
																	"description": "Identifies the detector wherever a match of it is reported.",
																	"validators": [
																		{
																			"custom": {
																				"imports": [
																					{
																						"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																					}
																				],
																				"schema_definition": "stringvalidator.LengthBetween(1, 64)"
																			}
																		},
																		{
																			"custom": {
																				"imports": [
																					{
																						"path": "regexp"
																					},
																					{
																						"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																					}
																				],
																				"schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^[a-zA-Z][a-zA-Z0-9_-]*$\"), \"\")"
																			}
																		}
																	]
																}
															}
														]
													},
													"description": "At most 32. Names must be unique within the store and must not be a built-in\ndetector id."
												}
											},
											{
												"name": "enabled",
