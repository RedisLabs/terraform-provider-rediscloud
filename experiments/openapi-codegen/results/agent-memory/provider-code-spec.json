{
	"provider": {
		"name": "rediscloud"
	},
	"resources": [
		{
			"name": "agent_memory",
			"schema": {
				"attributes": [
					{
						"name": "custom_memory_types",
						"list_nested": {
							"computed_optional_required": "computed_optional",
							"nested_object": {
								"attributes": [
									{
										"name": "description",
										"string": {
											"computed_optional_required": "required",
											"description": "Human-readable description of what this memory type captures.",
											"validators": [
												{
													"custom": {
														"imports": [
															{
																"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
															}
														],
														"schema_definition": "stringvalidator.LengthBetween(1, 200)"
													}
												}
											]
										}
									},
									{
										"name": "extraction_strategy",
										"single_nested": {
											"computed_optional_required": "computed_optional",
											"attributes": [
												{
													"name": "enabled",
													"bool": {
														"computed_optional_required": "computed_optional",
														"description": "Whether the strategy is active. Defaults to true when omitted."
													}
												},
												{
													"name": "prompt",
													"string": {
														"computed_optional_required": "required",
														"description": "Prompt used to extract memories of this type from session events."
													}
												}
											],
											"description": "Extraction strategy for a custom memory type."
										}
									},
									{
										"name": "fields",
										"list_nested": {
											"computed_optional_required": "computed_optional",
											"nested_object": {
												"attributes": [
													{
														"name": "description",
														"string": {
															"computed_optional_required": "required",
															"description": "Human-readable description of the field.",
															"validators": [
																{
																	"custom": {
																		"imports": [
																			{
																				"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																			}
																		],
																		"schema_definition": "stringvalidator.LengthBetween(1, 200)"
																	}
																}
															]
														}
													},
													{
														"name": "name",
														"string": {
															"computed_optional_required": "required",
															"description": "Field name.",
															"validators": [
																{
																	"custom": {
																		"imports": [
																			{
																				"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																			}
																		],
																		"schema_definition": "stringvalidator.LengthBetween(1, 64)"
																	}
																},
																{
																	"custom": {
																		"imports": [
																			{
																				"path": "regexp"
																			},
																			{
																				"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																			}
																		],
																		"schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^[a-zA-Z][a-zA-Z0-9_-]*$\"), \"\")"
																	}
																}
															]
														}
													},
													{
														"name": "type",
														"string": {
															"computed_optional_required": "required",
															"description": "Supported custom field data types.",
															"validators": [
																{
																	"custom": {
																		"imports": [
																			{
																				"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
																			}
																		],
																		"schema_definition": "stringvalidator.OneOf(\n\"STRING\",\n\"INTEGER\",\n\"FLOAT\",\n\"BOOLEAN\",\n\"STRING_LIST\",\n\"FLOAT_LIST\",\n\"OBJECT\",\n)"
																	}
																}
															]
														}
													}
												]
											},
											"description": "Structured fields that make up a record of this type. Optional; a type with no\nfields accepts direct writes carrying no structured attributes."
										}
									},
									{
										"name": "name",
										"string": {
											"computed_optional_required": "required",
											"description": "Unique type name within the store. Must not collide with built-in types\n(semantic, episodic, message, session_summary, session_summary_view).",
											"validators": [
												{
													"custom": {
														"imports": [
															{
																"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
															}
														],
														"schema_definition": "stringvalidator.LengthBetween(1, 64)"
													}
												},
												{
													"custom": {
														"imports": [
															{
																"path": "regexp"
															},
															{
																"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
															}
														],
														"schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^[a-zA-Z][a-zA-Z0-9_-]*$\"), \"\")"
													}
												}
											]
										}
									},
									{
										"name": "revision",
										"string": {
											"computed_optional_required": "computed_optional",
											"description": "Opaque revision returned on reads. Server assigned; ignored on creation.",
											"validators": [
												{
													"custom": {
														"imports": [
															{
																"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
															}
														],
														"schema_definition": "stringvalidator.LengthBetween(1, 64)"
													}
												}
											]
										}
									}
								]
							},
							"description": "Custom memory types to register on the store. Optional; when omitted the\nstore uses only built-in memory types."
						}
					},
					{
						"name": "database",
						"single_nested": {
							"computed_optional_required": "required",
							"attributes": [
								{
									"name": "database_id",
									"string": {
										"computed_optional_required": "required",
										"description": "The database ID.",
										"validators": [
											{
												"custom": {
													"imports": [
														{
															"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
														}
													],
													"schema_definition": "stringvalidator.LengthBetween(1, 32)"
												}
											}
										]
									}
								},
								{
									"name": "name",
									"string": {
										"computed_optional_required": "computed",
										"description": "The database name."
									}
								},
								{
									"name": "redis_cloud",
									"single_nested": {
										"computed_optional_required": "computed",
										"attributes": [
											{
												"name": "access_cidrs",
												"list": {
													"computed_optional_required": "computed",
													"element_type": {
														"string": {}
													},
													"description": "Database CIDR allow-list items."
												}
											},
											{
												"name": "provider",
												"string": {
													"computed_optional_required": "computed",
													"description": "The cloud provider where the database is provisioned."
												}
											},
											{
												"name": "region",
												"string": {
													"computed_optional_required": "computed",
													"description": "The cloud region where the database is provisioned."
												}
											}
										],
										"description": "Redis Cloud details of a database."
									}
								}
							],
							"description": "The database to store memory data in."
						}
					},
					{
						"name": "extraction_cadence",
						"single_nested": {
							"computed_optional_required": "computed_optional",
							"attributes": [
								{
									"name": "active_interval_seconds",
									"int64": {
										"computed_optional_required": "required",
										"description": "Interval in seconds between extraction runs while a session is active.",
